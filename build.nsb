cflags = -Wall -Wextra -Ilibs/viking/include -Ilibs/viking/libs -Ilibs/viking/libs/winx/include -Ilibs/cns/include -ggdb
ldflags = -lX11 -lXext -lXrandr -lXfixes -lGLX -lvulkan -lm
build_dir = build
shader_spvs = $build_dir/shaders/text.vert.spv $build_dir/shaders/text.frag.spv $build_dir/shaders/sel.vert.spv $build_dir/shaders/sel.frag.spv $build_dir/shaders/shape.vert.spv $build_dir/shaders/shape.frag.spv $build_dir/shaders/circle.vert.spv $build_dir/shaders/circle.frag.spv
fonts = fonts/MonaspaceNeon-Regular.otf

[jet]
src = src/jet/**.c src/common/**.c
deps = viking winx cns
ghost_deps = $build_dir/assets.c
cflags = $cflags
ldflags = $ldflags
incpath = $build_dir

[jwrap]
src = src/jwrap/**.c src/common/**.c
deps = cns
cflags = $cflags
incpath = $build_dir

[$build_dir/assets.c]
type = custom
cmd = ./bundler $build_dir/assets.c $shader_spvs $fonts
src = shaders/*
deps = bundler $shader_spvs

[$build_dir/shaders/text.vert.spv]
type = custom
cmd = glslc -o $build_dir/shaders/text.vert.spv shaders/text.vert
src = shaders/text.vert

[$build_dir/shaders/text.frag.spv]
type = custom
cmd = glslc -o $build_dir/shaders/text.frag.spv shaders/text.frag
src = shaders/text.frag

[$build_dir/shaders/sel.vert.spv]
type = custom
cmd = glslc -o $build_dir/shaders/sel.vert.spv shaders/sel.vert
src = shaders/sel.vert

[$build_dir/shaders/sel.frag.spv]
type = custom
cmd = glslc -o $build_dir/shaders/sel.frag.spv shaders/sel.frag
src = shaders/sel.frag

[$build_dir/shaders/shape.vert.spv]
type = custom
cmd = glslc -o $build_dir/shaders/shape.vert.spv shaders/shape.vert
src = shaders/shape.vert

[$build_dir/shaders/shape.frag.spv]
type = custom
cmd = glslc -o $build_dir/shaders/shape.frag.spv shaders/shape.frag
src = shaders/shape.frag

[$build_dir/shaders/circle.vert.spv]
type = custom
cmd = glslc -o $build_dir/shaders/circle.vert.spv shaders/circle.vert
src = shaders/circle.vert

[$build_dir/shaders/circle.frag.spv]
type = custom
cmd = glslc -o $build_dir/shaders/circle.frag.spv shaders/circle.frag
src = shaders/circle.frag

[bundler]
src = src/bundler/**.c
cflags = $cflags
incpath = $build_dir

[viking]
type = custom
name_type = static_lib
cmd = make -C libs/viking -B && cp libs/viking/libviking.* .
src = libs/viking/src/**.c

[winx]
type = custom
name_type = static_lib
cmd = make CFLAGS=-DWINX_VULKAN -C libs/viking/libs/winx -B && cp libs/viking/libs/winx/libwinx.* .
src = libs/viking/libs/winx/src/**.c

[cns]
type = custom
name_type = static_lib
cmd = cp libs/cns/build-unix.nsb libs/cns/build.nsb && ./nsb libs/cns && cp libs/cns/libcns.* .
src = libs/cns/src/**.c
